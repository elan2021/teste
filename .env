
# Variáveis de ambiente para conexão com o Supabase
# Copie este arquivo para .env e preencha com suas credenciais

# A URL do seu projeto Supabase
SUPABASE_URL=https://your-project-id.supabase.co

# A chave anônima (pública) do seu projeto Supabase
SUPABASE_ANON_KEY=your-public-anon-key

# A chave de serviço (secreta) para operações de administração
# Mantenha esta chave em segurança e não a exponha no lado do cliente
SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key
